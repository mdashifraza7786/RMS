# NextAuth Configuration
# Run 'openssl rand -base64 32' to generate a strong secret
NEXTAUTH_SECRET=your_nextauth_secret_here

# Socket server URL
SOCKET=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=rms
DB_CONN_LIMIT=10
DB_CONNECT_TIMEOUT=5000

# Note: Create a .env file with these variables in your project root
# Next.js will automatically load them. DO NOT commit .env to version control.